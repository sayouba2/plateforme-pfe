# Modèle public de développement, à copier vers .env puis à compléter localement.
# Les champs secrets sont volontairement vides. Ne jamais commiter le fichier .env.
# Générer chaque secret séparément : python -c 'import secrets; print(secrets.token_urlsafe(50))'

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_API_DOCS_ENABLED=True

# PostgreSQL Docker. Utiliser un mot de passe URL-safe dans DATABASE_URL.
POSTGRES_DB=pfe
POSTGRES_USER=pfe
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://pfe:REMPLACER@127.0.0.1:5432/pfe

# Redis Docker. Adapter les ports aux conteneurs locaux si Django tourne dans le venv.
CACHE_URL=redis://127.0.0.1:6379/1
REDIS_PASSWORD=

# docker-compose.yml remplace les URLs par les noms de services internes.
# Pour le venv : définir DJANGO_READ_DOT_ENV=True lors du lancement de Django.
